  "rules": {
    "LIB_MOVE": {
      "description": "Reader moves one cell on a shortest path to the help desk.",
      "conditions": [
        "reader needs help",
        "reader is not at desk",
        "walkable path exists"
      ],
      "effect": "move one legal cell toward desk"
    },
    "LIB_QUEUE": {
      "description": "Arriving reader joins the service queue for the next step.",
      "conditions": [
        "reader arrives at desk"
      ],
      "effect": "append to queue for next step"
    },
    "LIB_SERVE": {
      "description": "Open desk serves at most one previously queued reader.",
      "conditions": [
        "desk open",
        "reader queued before step"
      ],
      "effect": "serve one reader and remove from queue"
    },
    "LIB_READ": {
      "description": "Reader without a help request keeps reading.",
      "conditions": [
        "reader has no help request and is reading"
      ],
      "effect": "remain reading"
    },
    "WORK_MOVE": {
      "description": "Worker moves to counter or workstation along a shortest path.",
      "conditions": [
        "worker has a destination",
        "walkable path exists"
      ],
      "effect": "move one legal cell"
    },
    "WORK_QUEUE": {
      "description": "Arriving worker joins loan or return queue for the next step.",
      "conditions": [
        "worker arrives at counter"
      ],
      "effect": "append to loan or return queue for next step"
    },
    "WORK_LOAN": {
      "description": "Storekeeper lends one available drill to a queued worker.",
      "conditions": [
        "drill available",
        "worker queued before step",
        "no return handover this step"
      ],
      "effect": "transfer one drill to worker"
    },
    "WORK_RETURN": {
      "description": "Storekeeper accepts one returned drill before any loan.",
      "conditions": [
        "worker with drill queued to return before step"
      ],
      "effect": "transfer one drill to counter and complete job"
    },
    "WORK_JOB": {
      "description": "Worker holding a drill completes one work unit at workstation.",
      "conditions": [
        "worker holds drill",
        "worker at workstation",
        "work remains"
      ],
      "effect": "reduce work_left by one"
    }
  },
